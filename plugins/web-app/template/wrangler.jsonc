{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__APP_NAME__",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/solid-start/server-entry",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__APP_NAME__",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}